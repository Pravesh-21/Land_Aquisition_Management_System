# ============================================
# BHU-NIRIKSHAN Environment Configuration Template
# Copy this file to .env and configure local values
# ============================================

# --- Application ---
APP_NAME=BHU-NIRIKSHAN-API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://bhudrishti:bhudrishti_pass@localhost:5432/bhudrishti_db
POSTGRES_USER=bhudrishti
POSTGRES_PASSWORD=bhudrishti_pass
POSTGRES_DB=bhudrishti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT Authentication & Security ---
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cookie Security ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Rate Limiting ---
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# --- Citizen OTP & Verification ---
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_SECRET_SALT=replace-with-a-secure-salt-string-for-otp-hashing

# --- Email Provider (SMTP) ---
SMTP_HOST=smtp.gov.in
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@bhu-nirikshan.gov.in
SMTP_USE_TLS=true

# --- WhatsApp Provider (Meta Cloud API) ---
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-access-token
WHATSAPP_TEMPLATE_NAME=bhu_nirikshan_otp

# --- Seed Configuration ---
SEED_PASSWORD=Pass@123

# --- CORS & Networking ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
