# ============================================
# BHU-NIRIKSHAN Environment Configuration Template
# Copy this file to .env and configure local values
# ============================================

# --- Application ---
APP_NAME=BHU-NIRIKSHAN-API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://bhudrishti:bhudrishti_pass@localhost:5432/bhudrishti_db
POSTGRES_USER=bhudrishti
POSTGRES_PASSWORD=bhudrishti_pass
POSTGRES_DB=bhudrishti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT Authentication & Security ---
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed Configuration ---
SEED_PASSWORD=Pass@123

# --- CORS & Networking ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
