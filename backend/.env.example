# ============================================
# BHU-DRISHTI Backend Environment Template
# Copy this file to .env and set actual secrets
# ============================================

APP_NAME=BHU-DRISHTI-API
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://bhudrishti:bhudrishti_pass@localhost:5432/bhudrishti_db
POSTGRES_USER=bhudrishti
POSTGRES_PASSWORD=bhudrishti_pass
POSTGRES_DB=bhudrishti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=bhu-drishti-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bhu-drishti-documents
MINIO_SECURE=false

YOLO_MODEL_PATH=./models/yolov8m-obb.onnx
XGBOOST_MODEL_PATH=./models/risk_classifier.json

MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
BHUVAN_API_KEY=your_bhuvan_api_key_here
BHOONIDHI_API_KEY=your_bhoonidhi_api_key_here
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
